# Keeps one Dynmap map up to date around chunks the game server saved (tools/auto_update.py). NOT installed by default:
#   sudo cp docker/toro-gpu-watch.service /etc/systemd/system/toro-gpu-watch-flat-t.service   (edit paths/ids first)
#   sudo systemctl enable --now toro-gpu-watch-flat-t
# One unit per map (flat/t = MapID 30002 iso_SE_30_hires, flat/flat = 30001 iso_S_90_lowres, ...). The renderer container
# has a fixed name, so two watchers (or a watcher and a whole-map job) never render at the same time: the loser retries.
[Unit]
Description=TORO GPU map updater (flat/t)
After=docker.service
Requires=docker.service

[Service]
User=user
WorkingDirectory=/home/user/gpu-renderer-lab/repo
ExecStart=/usr/bin/python3 tools/auto_update.py --map-id 30002 --persp iso_SE_30_hires --zoom-max 7 \
    --extra-groups 1001 --world-dir /srv/minecraft/worlds/flat/region
Nice=19
IOSchedulingClass=idle
CPUWeight=1
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
